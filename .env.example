# Template only. Never put real secrets in this file.
# Copy to a local, ignored environment file after the stack is selected.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Public SEO origin: set only after the production domain is confirmed.
# SITE_INDEXING_ENABLED must remain false until the public site is approved.
# NEXT_PUBLIC_SITE_URL=https://www.your-confirmed-domain.com
SITE_INDEXING_ENABLED=false

# Supabase public client configuration. The publishable key is intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://xpbjdeknjudurulogjkr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production must use the exact HTTPS origin configured in Supabase Auth URL settings.
# Never add a service-role or secret key to NEXT_PUBLIC_* variables.

# Private object storage
# STORAGE_ENDPOINT=
# STORAGE_BUCKET_PRIVATE=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Email / notifications
# EMAIL_PROVIDER=
# EMAIL_FROM=
# EMAIL_API_KEY=

# Maps / geocoding
# MAPS_PROVIDER=
# MAPS_API_KEY=

# Observability
# ERROR_TRACKING_DSN=

# Add variables only when the corresponding integration is selected.
# Never use production credentials in local development or commit actual values.

# Server-only database, authentication, email and private-storage credentials
# are intentionally not defined until vendors and access policies are approved.

# Server-only application secrets. Set in the deployment environment, not in browser code.
# Required by public inquiry and authenticated service-request API routes.
SUPABASE_SECRET_KEY=replace_with_project_secret_key
# Independent random value, at least 32 characters; used only for inquiry IP HMAC.
INQUIRY_RATE_LIMIT_SECRET=replace_with_random_secret_at_least_32_characters
# Scanner callback HMAC secret (at least 32 characters); configure only when a real scanner is deployed.
# DOCUMENT_SCANNER_WEBHOOK_SECRET=replace_with_independent_random_secret_at_least_32_characters

# These are Supabase Edge Function secrets, NOT Next.js environment variables:
# SUPABASE_SERVICE_ROLE_KEY
# STAFF_BOOTSTRAP_ADMIN_USER_ID (one-time bootstrap only; remove after first admin)
# SUPABASE_URL (normally provided by Supabase Edge Functions)

# These are GitHub Actions repository secrets for the manual migration-history workflow:
# SUPABASE_ACCESS_TOKEN
# SUPABASE_DB_PASSWORD
