# Template only. Never put real secrets in this file.
# Copy to a local, ignored environment file after the stack is selected.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Public SEO origin: set only after the production domain is confirmed.
# SITE_INDEXING_ENABLED must remain false until the public site is approved.
# NEXT_PUBLIC_SITE_URL=https://www.your-confirmed-domain.com
SITE_INDEXING_ENABLED=false

# Authentication / database
# AUTH_PROVIDER=
# DATABASE_URL=

# Private object storage
# STORAGE_ENDPOINT=
# STORAGE_BUCKET_PRIVATE=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Email / notifications
# EMAIL_PROVIDER=
# EMAIL_FROM=
# EMAIL_API_KEY=

# Maps / geocoding
# MAPS_PROVIDER=
# MAPS_API_KEY=

# Observability
# ERROR_TRACKING_DSN=

# Add variables only when the corresponding integration is selected.
# Never use production credentials in local development or commit actual values.

# Server-only database, authentication, email and private-storage credentials
# are intentionally not defined until vendors and access policies are approved.
